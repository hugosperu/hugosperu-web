    {
      "route": "/hp/*",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/hp",
      "redirect": "/",
      "statusCode": 301
    },
    {
      "route": "/derechos-constitucionales",
      "redirect": "/derechos-constitucionales/",
      "statusCode": 301
    },
    {
      "route": "/derecho-civil",
