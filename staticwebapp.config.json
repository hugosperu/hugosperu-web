    {
      "route": "/derecho-penal",
      "redirect": "/derecho-penal/",
      "statusCode": 301
    },
    {
      "route": "/derecho-laboral",
      "redirect": "/derecho-laboral/",
      "statusCode": 301
    },
    {
      "route": "/derecho-pensionario",
      "redirect": "/derecho-pensionario/",
      "statusCode": 301
    },
    {
      "route": "/fonavi",
      "redirect": "/fonavi/",
      "statusCode": 301
    },
    {
      "route": "/derecho-administrativo",
      "redirect": "/derecho-administrativo/",
      "statusCode": 301
    },
    {
      "route": "/derecho-arbitral",
      "redirect": "/derecho-arbitral/",
      "statusCode": 301
    },
    {
      "route": "/derecho-ambiental",
      "redirect": "/derecho-ambiental/",
      "statusCode": 301
    },
    {
      "route": "/derecho-tributario",
      "redirect": "/derecho-tributario/",
      "statusCode": 301
    },
    {
      "route": "/derecho-de-contrataciones-del-estado",
      "redirect": "/derecho-de-contrataciones-del-estado/",
      "statusCode": 301
    },
    {
      "route": "/derecho-de-cyberseguridad",
      "redirect": "/derecho-de-cyberseguridad/",
      "statusCode": 301
    },
    {
      "route": "/derecho-de-seguridad-y-salud-en-el-trabajo",
      "redirect": "/derecho-de-seguridad-y-salud-en-el-trabajo/",
      "statusCode": 301
    },
    {
      "route": "/indemnizaciones",
      "redirect": "/indemnizaciones/",
      "statusCode": 301
    },
    {
      "route": "/gestion-publica",
      "redirect": "/gestion-publica/",
      "statusCode": 301
    },
    {
      "route": "/costos-y-costas",
      "redirect": "/costos-y-costas/",
      "statusCode": 301
    },
    {
      "route": "/derecho-a-la-salud",
      "redirect": "/derecho-a-la-salud/",
      "statusCode": 301
    },
    {
      "route": "/assets/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/img/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/pdfs/*",
      "headers": {
        "cache-control": "public, max-age=2592000"
      }
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Content-Security-Policy": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; object-src 'none'"
  },
  "mimeTypes": {
    ".svg": "image/svg+xml",
    ".pdf": "application/pdf"
  }
}
